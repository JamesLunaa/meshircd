__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Secrets
.env

# Packaging build output
build/
dist/

# TLS material -- never commit a private key or cert
*.pem
*.key
*.crt

# Runtime data: account/channel database (sqlite, see storage.py) and the
